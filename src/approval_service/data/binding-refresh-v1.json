{
  "id": "aweb.awsign.binding-refresh",
  "version": 1,
  "meaning": "A currently valid person carries a re-signed active binding from their checked current certificate issuer or namespace controller. The active generation and previous binding commitment fence the update. Only issuer, signature and current certificate may change; the person, identity key, site and exact credential declarations stay the same. The service retains historical statements and receipts unchanged and records the authenticated carrier and old/new bindings and issuers for the operator.",
  "http": {
    "purpose": "binding_refresh",
    "path": "/v1/enrollment-bindings/refresh"
  },
  "$defs": {
    "binding_refresh_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requester",
        "previous_binding_commitment",
        "binding",
        "id_chain"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "requester": {
          "$ref": "#/$defs/requester"
        },
        "previous_binding_commitment": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "id_chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "binding_refresh_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "person",
        "state",
        "binding_commitment"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "person": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "const": "active"
        },
        "binding_commitment": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "binding_refresh_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "error"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,127}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        }
      }
    }
  }
}
