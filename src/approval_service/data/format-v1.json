{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human approval format 1",
  "x-domains": {
    "request": "aweb.human-approval-request/1\n",
    "binding": "aweb.human-enrollment-binding/1\n",
    "nonce": "aweb.human-approval-nonce/1\n",
    "http_request": "aweb.awsign-http-request/1\n",
    "enrollment_intent": "aweb.awsign-enrollment-intent/1\n",
    "enrollment_locator": "aweb.awsign-enrollment-locator/1\n",
    "binding_commitment": "aweb.human-enrollment-commitment/1\n",
    "receipt_commitment": "aweb.human-approval-receipt/1\n",
    "identity_evidence": "aweb.human-id-evidence/1\n"
  },
  "$defs": {
    "requester": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "identity"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "team_id",
            "certificate_id",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "team_member"
            },
            "team_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "certificate_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "namespace",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "namespace_controller"
            },
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      ]
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "algorithm",
        "grade",
        "snapshot",
        "grade_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "algorithm": {
          "type": "integer",
          "enum": [
            -7,
            -8,
            -257
          ]
        },
        "grade": {
          "enum": [
            "passkey_uv",
            "certified_hardware"
          ]
        },
        "snapshot": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "grade_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "binding_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "organisation",
        "person",
        "certificate",
        "identity_key",
        "issuer",
        "origin",
        "rp_id",
        "credentials"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "person": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "certificate": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "identity_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rp_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
        },
        "credentials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/credential"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "signature"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/binding_body"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "client_data_json",
        "authenticator_data",
        "signature"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "client_data_json": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "authenticator_data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "organisation",
        "approver",
        "requester",
        "enforcer",
        "definition",
        "act",
        "not_before",
        "deadline",
        "nonce"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "purpose": {
          "enum": [
            "act_approval",
            "enrollment_confirmation"
          ]
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "approver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requester": {
          "$ref": "#/$defs/requester"
        },
        "enforcer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audience"
          ],
          "properties": {
            "audience": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "version": {
              "const": 1,
              "type": "integer"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "act": {
          "type": "object"
        },
        "not_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nonce": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kid",
            "value"
          ],
          "properties": {
            "kid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 1048576
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_bytes",
        "binding",
        "id_chain",
        "assertion"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "request_bytes": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "id_chain": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object"
          }
        },
        "assertion": {
          "$ref": "#/$defs/assertion"
        }
      }
    },
    "binary": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 1048576
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "client_data_json",
        "attestation_object"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/binary"
        },
        "client_data_json": {
          "$ref": "#/$defs/binary"
        },
        "attestation_object": {
          "$ref": "#/$defs/binary"
        }
      }
    },
    "http_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "requester",
        "origin",
        "method",
        "path",
        "issued_at",
        "body_sha256"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "purpose": {
          "enum": [
            "submit",
            "poll",
            "cancel",
            "enrollment_start",
            "enrollment_material",
            "enrollment_confirm",
            "enrollment_activate"
          ]
        },
        "requester": {
          "$ref": "#/$defs/requester"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "method": {
          "const": "POST",
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "http_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof",
        "signature"
      ],
      "properties": {
        "proof": {
          "$ref": "#/$defs/http_proof"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_certificate",
        "id_chain"
      ],
      "properties": {
        "team_certificate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          ]
        },
        "id_chain": {
          "type": "array",
          "maxItems": 8
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_bytes",
        "admission"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "request_bytes": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "admission": {
          "$ref": "#/$defs/admission"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "locator",
        "digest",
        "admission",
        "request_bytes"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "admission": {
          "$ref": "#/$defs/admission"
        },
        "request_bytes": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        }
      }
    },
    "needs_human": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "approval_origin",
        "request_bytes",
        "digest"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "status": {
          "const": "needs_human",
          "type": "string"
        },
        "approval_origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "request_bytes": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_bytes",
        "receipt"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "request_bytes": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
        }
      }
    },
    "enrollment_intent_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "organisation",
        "person",
        "pending_certificate",
        "identity_key",
        "requester",
        "origin",
        "rp_id",
        "challenge",
        "not_before",
        "deadline"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "purpose": {
          "const": "enroll_person",
          "type": "string"
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "person": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "pending_certificate": {
          "type": "object"
        },
        "identity_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requester": {
          "$ref": "#/$defs/requester"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rp_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
        },
        "challenge": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "not_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "enrollment_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "signature"
      ],
      "properties": {
        "intent": {
          "$ref": "#/$defs/enrollment_intent_body"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        }
      }
    },
    "enrollment_start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "intent",
        "admission"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "intent": {
          "$ref": "#/$defs/enrollment_intent"
        },
        "admission": {
          "$ref": "#/$defs/admission"
        }
      }
    },
    "creation_evidence_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "organisation",
        "subject",
        "issuer",
        "binding_commitment",
        "creation"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "kind": {
          "const": "human",
          "type": "string"
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "certificate",
            "key"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "certificate": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "binding_commitment": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "creation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "credential",
            "grade",
            "receipt_commitment"
          ],
          "properties": {
            "credential": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 1048576
            },
            "grade": {
              "enum": [
                "passkey_uv",
                "certified_hardware"
              ]
            },
            "receipt_commitment": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "creation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "signature"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/creation_evidence_body"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        }
      }
    },
    "enrollment_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "intent",
        "binding",
        "creation_receipt",
        "evidence",
        "id_chain"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "intent": {
          "$ref": "#/$defs/enrollment_intent"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "creation_receipt": {
          "$ref": "#/$defs/receipt"
        },
        "evidence": {
          "$ref": "#/$defs/creation_evidence"
        },
        "id_chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8
        }
      }
    },
    "submit_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "locator",
        "digest",
        "deadline",
        "state"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "denied",
            "cancelled",
            "expired"
          ]
        }
      }
    },
    "cancel_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "locator",
        "digest",
        "deadline",
        "state"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "approved",
            "denied",
            "cancelled",
            "expired"
          ]
        }
      }
    },
    "approval_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion",
        "binding",
        "id_chain"
      ],
      "properties": {
        "assertion": {
          "$ref": "#/$defs/assertion"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "id_chain": {
          "type": "array",
          "maxItems": 8
        }
      }
    },
    "decision_answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "locator",
            "digest",
            "deadline",
            "state",
            "approval"
          ],
          "properties": {
            "version": {
              "const": 1,
              "type": "integer"
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "deadline": {
