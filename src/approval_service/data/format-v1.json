{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human approval format 1",
  "x-domains": {
    "request": "aweb.human-approval-request/1\n",
    "binding": "aweb.human-enrollment-binding/1\n",
    "nonce": "aweb.human-approval-nonce/1\n"
  },
  "$defs": {
    "requester": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "identity"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "team_id",
            "certificate_id",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "team_member"
            },
            "team_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "certificate_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "namespace",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "namespace_controller"
            },
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      ]
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key",
        "algorithm",
        "grade",
        "snapshot",
        "grade_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "algorithm": {
          "type": "integer",
          "enum": [
            -7,
            -8,
            -257
          ]
        },
        "grade": {
          "enum": [
            "passkey_uv",
            "certified_hardware"
          ]
        },
        "snapshot": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          ]
        },
        "grade_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "binding_body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "organisation",
        "person",
        "certificate",
        "identity_key",
        "issuer",
        "origin",
        "rp_id",
        "credentials"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "person": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "certificate": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "identity_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "rp_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"
        },
        "credentials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/credential"
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "signature"
      ],
      "properties": {
        "binding": {
          "$ref": "#/$defs/binding_body"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "client_data_json",
        "authenticator_data",
        "signature"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "client_data_json": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "authenticator_data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "purpose",
        "organisation",
        "approver",
        "requester",
        "enforcer",
        "definition",
        "act",
        "not_before",
        "deadline",
        "nonce"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "purpose": {
          "enum": [
            "act_approval",
            "enrollment_confirmation"
          ]
        },
        "organisation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "approver": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "requester": {
          "$ref": "#/$defs/requester"
        },
        "enforcer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audience"
          ],
          "properties": {
            "audience": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "version": {
              "const": 1,
              "type": "integer"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "act": {
          "type": "object"
        },
        "not_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nonce": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kid",
            "value"
          ],
          "properties": {
            "kid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 1048576
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_bytes",
        "binding",
        "id_chain",
        "assertion"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "request_bytes": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 1048576
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "id_chain": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object"
          }
        },
        "assertion": {
          "$ref": "#/$defs/assertion"
        }
      }
    }
  }
}
