{
  "id": "agent.root.authorize",
  "version": 1,
  "purpose": "act_approval",
  "act_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "operation",
      "target",
      "expected_revision"
    ],
    "properties": {
      "operation": {
        "type": "string",
        "const": "agent.root.authorize"
      },
      "target": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person",
          "root_id",
          "root_key",
          "mode",
          "teams"
        ],
        "properties": {
          "person": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "root_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "root_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "mode": {
            "type": "string",
            "enum": [
              "issue",
              "adopt"
            ]
          },
          "teams": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?:[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
            },
            "uniqueItems": true
          }
        }
      },
      "expected_revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "display": {
    "heading": "Approve a root agent",
    "consequence": "Approve this person\u2019s root. At a team-key enforcer, replace its admission grant with exactly the listed teams; an empty list withdraws the grant. Agent descendants are attributed through the ID chain.",
    "technical_fields": [
      "organisation",
      "target.person",
      "target.root_id",
      "target.root_key",
      "target.mode",
      "target.teams",
      "expected_revision"
    ]
  }
}
